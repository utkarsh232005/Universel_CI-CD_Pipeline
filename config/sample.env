# Sample Project Configuration
# Copy this file and customize for your project

# Project Information
PROJECT_NAME="NextJS E-Commerce"

# Build Configuration
BUILD_COMMAND="npm run build"
INSTALL_DEPENDENCIES="true"
BUILD_DIR="./out"

# Test Configuration
TEST_COMMAND="npm run test"
LINT_COMMAND="npm run lint"
COVERAGE_COMMAND="npm run coverage"

# Docker Configuration
DOCKER_IMAGE="myorg/next-ecommerce"
DOCKER_TAG="latest"

# Deployment Configuration
DEPLOY_TYPE="dockerhub"  # Options: dockerhub, aws_ec2, aws_s3, heroku, vercel, netlify, custom, none
DEPLOY_PATH="/var/www/html"

# AWS EC2 Deployment (if using aws_ec2)
# AWS_EC2_HOST="ec2-xx-xxx-xxx-xxx.compute-1.amazonaws.com"
# AWS_EC2_USER="ubuntu"

# AWS S3 Deployment (if using aws_s3)
# AWS_S3_BUCKET="my-app-bucket"
# AWS_CLOUDFRONT_ID="E1234567890ABC"

# Heroku Deployment (if using heroku)
# HEROKU_APP_NAME="my-app-name"

# Custom Deployment (if using custom)
# DEPLOY_COMMAND="./deploy-script.sh"
