# Default Configuration for Universal CI/CD Pipeline
# Override these values in your project-specific .env file

# Project Information
PROJECT_NAME="Generic Project"

# Build Configuration
BUILD_COMMAND="npm run build"
INSTALL_DEPENDENCIES="true"
BUILD_DIR="./build"

# Test Configuration
TEST_COMMAND="npm test"
LINT_COMMAND="npm run lint"
COVERAGE_COMMAND="none"

# Docker Configuration
DOCKER_IMAGE="generic-app"
DOCKER_TAG="latest"

# Deployment Configuration
DEPLOY_TYPE="none"
DEPLOY_PATH="/var/www/html"
DEPLOY_COMMAND=""

# AWS Configuration
AWS_EC2_HOST=""
AWS_EC2_USER=""
AWS_S3_BUCKET=""
AWS_CLOUDFRONT_ID=""

# Heroku Configuration
HEROKU_APP_NAME=""

# Vercel Configuration
VERCEL_TOKEN=""

# Netlify Configuration
NETLIFY_AUTH_TOKEN=""
NETLIFY_SITE_ID=""
