# Vue.js App Configuration Example
PROJECT_NAME="Vue.js Dashboard"

# Build Configuration
BUILD_COMMAND="npm run build"
INSTALL_DEPENDENCIES="true"
BUILD_DIR="./dist"

# Test Configuration
TEST_COMMAND="npm run test:unit"
LINT_COMMAND="npm run lint"
COVERAGE_COMMAND="none"

# Docker Configuration
DOCKER_IMAGE="none"

# Deployment Configuration
DEPLOY_TYPE="aws_s3"
AWS_S3_BUCKET="my-vue-dashboard-bucket"
AWS_CLOUDFRONT_ID="E1234567890ABC"

# AWS credentials should be in secrets:
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
