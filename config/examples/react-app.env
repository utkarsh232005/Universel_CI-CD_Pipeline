# React App Configuration Example
PROJECT_NAME="React Portfolio Website"

# Build Configuration
BUILD_COMMAND="npm run build"
INSTALL_DEPENDENCIES="true"
BUILD_DIR="./build"

# Test Configuration
TEST_COMMAND="npm run test -- --ci --coverage --watchAll=false"
LINT_COMMAND="npm run lint"
COVERAGE_COMMAND="none"

# Docker Configuration (optional for static sites)
DOCKER_IMAGE="none"

# Deployment Configuration
DEPLOY_TYPE="netlify"

# Netlify Configuration
# BUILD_DIR is used for deployment
# Requires NETLIFY_AUTH_TOKEN and NETLIFY_SITE_ID in secrets
