# Python Flask Project Configuration Example
PROJECT_NAME="Flask REST API"

# Build Configuration
BUILD_COMMAND="python -m pip install -r requirements.txt"
INSTALL_DEPENDENCIES="false"  # We handle it in BUILD_COMMAND
BUILD_DIR="./app"

# Test Configuration
TEST_COMMAND="pytest tests/ -v --cov=app"
LINT_COMMAND="flake8 app/ tests/"
COVERAGE_COMMAND="coverage report"

# Docker Configuration
DOCKER_IMAGE="myorg/flask-api"
DOCKER_TAG="latest"

# Deployment Configuration
DEPLOY_TYPE="aws_ec2"
AWS_EC2_HOST="ec2-xx-xxx-xxx-xxx.compute-1.amazonaws.com"
AWS_EC2_USER="ubuntu"
DEPLOY_PATH="/opt/flask-app"

# Custom deployment command
DEPLOY_COMMAND="scp -r app/ ubuntu@$AWS_EC2_HOST:$DEPLOY_PATH && ssh ubuntu@$AWS_EC2_HOST 'cd $DEPLOY_PATH && sudo systemctl restart flask-app'"
